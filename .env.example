# 0G Chain
OG_RPC_URL=
OG_CHAIN_ID=
DEPLOYER_PRIVATE_KEY=

# 0G Compute (TEE-verifiable inference)
# Provider/model are configured at runtime so the agent isn't tied to a model
# that may move between testnet and mainnet. Demo defaults to a chatbot service
# available on the active 0G network (e.g. qwen-2.5-7b-instruct on testnet).
OG_COMPUTE_PROVIDER_ADDRESS=
OG_COMPUTE_MODEL=
OG_COMPUTE_VERIFY=true

# 0G Storage
OG_STORAGE_INDEXER_URL=
OG_STORAGE_NODE_URL=

# Deployed addresses (filled after Deploy0G.s.sol + DeployHook + InitDynamicFeePool)
POOL_MANAGER=
RISK_POLICY_REGISTRY=
MOCK_POOL_SCENARIO=
RISK_HOOK=
POOL_ID=
TOKEN0=
TOKEN1=

# Filled after script/SetupSwapDemo.s.sol
SWAP_ROUTER=
LP_ROUTER=
OG_EXPLORER_URL=https://chainscan-galileo.0g.ai
