# RiskClaw MCP — read-only configuration
#
# Defaults below point at the live RiskClaw deployment on 0G Galileo testnet.
# `cp .env.example .env` should give you a working server out of the box.

# 0G Galileo RPC (chain id 16602)
OG_RPC_URL=https://evmrpc-testnet.0g.ai

# Live RiskPolicyRegistry on 0G Galileo
RISK_POLICY_REGISTRY=0x804b7Df3814c6ba5A47E93043EA8da66a21B9351

# 0G Storage indexer (used to fetch memos / proofs / metrics by content root)
OG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# Optional: explorer URL used in human-readable links returned by tools
OG_EXPLORER_URL=https://chainscan-galileo.0g.ai

# Optional: convenience pool id, used as a default if a tool is called without one
DEFAULT_POOL_ID=
